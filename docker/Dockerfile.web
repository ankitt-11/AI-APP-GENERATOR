FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache libc6-compat

# Copy workspace package configurations
COPY package.json turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies
RUN npm install

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Build shared package and then the Next.js application
RUN npm run build --workspace=@repo/shared

# Build Next.js
ENV NEXT_PUBLIC_API_URL=http://localhost:3001
RUN npm run build --workspace=@repo/web

EXPOSE 3000

# Start Next.js production server
CMD ["npm", "run", "start", "--workspace=@repo/web"]

# ─── NestJS API — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values

PORT=3001
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon, Supabase, Railway Postgres, or any PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your Vercel production URL (e.g. https://your-app.vercel.app)
FRONTEND_URL="https://your-app.vercel.app"

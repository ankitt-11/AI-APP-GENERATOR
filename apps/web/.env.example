# ─── Next.js Web App — Environment Variables ─────────────────────────────────
# Copy this to .env.local for local dev, or set in Vercel dashboard for production

# ─── API Connection ────────────────────────────────────────────────────────────
# Point to your Railway API URL in production
# e.g. https://your-api.up.railway.app/api
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Set NEXTAUTH_URL to your Vercel deployment URL in production
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

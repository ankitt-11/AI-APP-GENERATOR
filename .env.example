# ─── API GATEWAY ENVIRONMENT VARIABLES (apps/api/.env) ──────────────────────

PORT=3001
NODE_ENV=development

# Database connection
# For development, you can run postgres via docker-compose.
# Database URL format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiappgen?schema=public"

# Authentication Secrets
# Generate secure secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-at-least-32-chars"
JWT_EXPIRES_IN="15m"

# Rate Limiting Throttler
THROTTLE_TTL=60000
THROTTLE_LIMIT=100


# ─── FRONTEND APPLICATION ENVIRONMENT VARIABLES (apps/web/.env.local) ──────

# Base public URL of the NestJS API
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# NextAuth configuration
# NEXTAUTH_URL should match the hostname of the Next.js web application
NEXTAUTH_URL="http://localhost:3000"
# Generate secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"
